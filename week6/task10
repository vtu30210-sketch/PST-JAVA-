import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        
        // Read N
        String line1 = br.readLine();
        if (line1 == null) return;
        int n = Integer.parseInt(line1.trim());
        
        // Read String
        String s = br.readLine().trim();
        
        // Duplicate the string to handle circular/rotated context
        String s2 = s + s;
        
        // Transform the string for Manacher's Algorithm (e.g., "aba" -> "#a#b#a#")
        int s2Len = s2.length();
        int mLen = 2 * s2Len + 1;
        char[] t = new char[mLen];
        for (int i = 0; i < s2Len; i++) {
            t[2 * i] = '#';
            t[2 * i + 1] = s2.charAt(i);
        }
        t[mLen - 1] = '#';
        
        // Execute Manacher's Algorithm
        int[] p = new int[mLen];
        int c = 0, r = 0;
        for (int i = 0; i < mLen; i++) {
            int mirror = 2 * c - i;
            if (i < r) {
                p[i] = Math.min(r - i, p[mirror]);
            }
            
            while (i - 1 - p[i] >= 0 && i + 1 + p[i] < mLen && t[i - 1 - p[i]] == t[i + 1 + p[i]]) {
                p[i]++;
            }
            
            if (i + p[i] > r) {
                c = i;
                r = i + p[i];
            }
        }
        
        // Precompute Log table for Sparse Table queries
        int[] log = new int[mLen + 1];
        for (int i = 2; i <= mLen; i++) {
            log[i] = log[i >> 1] + 1;
        }
        
        // Build Sparse Table (RMQ) over the Manacher radius array `p`
        int kMax = log[mLen] + 1;
        int[][] st = new int[kMax][mLen];
        for (int i = 0; i < mLen; i++) {
            st[0][i] = p[i];
        }
        for (int j = 1; j < kMax; j++) {
            int len = 1 << (j - 1);
            for (int i = 0; i + 2 * len <= mLen; i++) {
                st[j][i] = Math.max(st[j - 1][i], st[j - 1][i + len]);
            }
        }
        
        // Helper function for O(1) range maximum queries
        // Returns the maximum value in array p within range [L, R]
        class QueryHelper {
            int query(int L, int R) {
                if (L > R) return 0;
                int j = log[R - L + 1];
                return Math.max(st[j][L], st[j][R - (1 << j) + 1]);
            }
        }
        QueryHelper qh = new QueryHelper();
        
        // Solve for each k-length rotation
        StringBuilder sb = new StringBuilder();
        for (int k = 0; k < n; k++) {
            int low = 1;
            int high = n;
            int best = 1;
            while (low <= high) {
                int mid = (low + high) / 2;
               
                // Map the valid window centers for a palindrome of length `mid`
                int cMin = 2 * k + mid;
                int cMax = 2 * k + 2 * n - mid;
                
                if (qh.query(cMin, cMax) >= mid) {
                    best = mid;
                    low = mid + 1; // Try to find a longer palindrome
                } else {
                    high = mid - 1;
                }
            }
            sb.append(best).append("\n");
        }
        
        // Fast output submission
        System.out.print(sb.toString());
    }
}
